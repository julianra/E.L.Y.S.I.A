# ============================================
# Rust / Cargo Gitignore
# ============================================

# Compiled files
target/

# Cargo lock files for libraries (for binaries keep Cargo.lock)
Cargo.lock

# Backup files
*.rs.bk

# IDE / Editor settings
.idea/
.vscode/
.DS_Store

# Logs
*.log

# Environment variables
.env

# Rust tools
rustfmt.toml
.clippy.toml

# Temporary or generated files
*.tmp
*.swp
*.swo
*~

# WASM build artifacts (for later)
wasm/
*.wasm
wasm-pack.log

# Build artifacts
/debug/
release/

# ELYSIA-specific (future plugins, state, runtime)
data/
logs/
snapshots/
# Flutter/Dart/Pub
.dart_tool/
.packages
.pub-cache/
.pub/
/build/
.flutter-plugins
.flutter-plugins-dependencies

# Generated plugin files
generated_plugin_registrant.dart

# IntelliJ / Android Studio
.idea/
*.iml

# VSCode
.vscode/
*.code-workspace

# Flutter-specific dependencies & tool state
.flutter-plugins
.flutter-plugins-dependencies
.flutter-versions
.canvaskit/
.flutter-plugins
.flutter-plugins-dependencies
.metadata

# Android
**/android/local.properties
**/android/.gradle/
**/android/.idea/
**/android/captures/
**/android/app/debug/
**/android/app/profile/
**/android/app/release/

# Gradle
.gradle/
**/build/
gradlew
gradlew.bat
gradle-wrapper.jar

# iOS
**/ios/Flutter/.last_build_id
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/App.framework
**/ios/.symlinks/
**/ios/Pods/
**/ios/build/
**/ios/Runner.xcworkspace/
**/ios/Runner.xcarchive/

# macOS
**/macos/Flutter/ephemeral/
**/macos/Flutter/Flutter-Debug.app/
**/macos/Flutter/Flutter-Release.app/
**/macos/Flutter/Flutter-Profile.app/
**/macos/Pods/
**/macos/build/

# Windows
**/windows/flutter/ephemeral/
**/windows/build/

# Linux
**/linux/flutter/ephemeral/
**/linux/build/

# Web
**/web/.dart_tool/
**/web/.flutter-plugins

# Xcode
*.xcuserstate
*.xcuserdata
*.xcuserdatad
*.moved-aside
DerivedData/
*.xcworkspace
*.xccheckout
!default.xcworkspace

# CocoaPods
Pods/
Podfile.lock

# Other
.env
*.log
*.tmp
*.swp
*.swo

# Sentry / crash dumps
*.dmp

# Firebase configs (optioneel—haal weg als je wél wil committen)
# google-services.json
# GoogleService-Info.plist
