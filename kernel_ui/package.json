{
  "name": "kernel_ui",
  "version": "0.1.0",
  "description": "ELYSIA local kernel user interface",
  "author": "ELYSIA",
  "type": "module",
  "main": "electron/main.cjs",

  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron": "npm run build && electron .",
    "dist": "npm run build && electron-builder"
  },

  "build": {
    "appId": "local.elysia.kernelui",
    "productName": "ELYSIA Kernel UI",

    "files": [
      "dist/**/*",
      "electron/**/*",
      "bin/**/*"
    ],

    "asarUnpack": [
      "bin/**"
    ],

    "directories": {
      "output": "release"
    },

    "win": {
      "target": "nsis"
    }
  }
}
