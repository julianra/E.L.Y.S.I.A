{
  "name": "kernel_ui",
  "version": "0.1.0",
  "description": "ELYSIA Kernel UI",
  "author": "Julian Rai Anwor",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"npm run dev:svelte\" \"npm run dev:electron\"",
    "dev:svelte": "vite dev --port 5173",
    "dev:electron": "electron .",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "dist": "vite build && electron-builder"
  },
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "concurrently": "^9.2.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  },
  "build": {
    "appId": "elysia.kernel.ui",
    "productName": "ELYSIA Kernel UI",
    "directories": {
      "output": "dist"
    },
    "files": [
      {
        "from": "build",
        "to": "build"
      },
      {
        "from": "electron",
        "to": "electron"
      }
    ],
    "extraResources": [
      {
        "from": "electron/kernel-bin",
        "to": "electron/kernel-bin"
      }
    ],
    "win": {
      "target": "nsis"
    }
  }
}
